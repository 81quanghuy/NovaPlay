{
  "//": "Copy thành tilt-settings.json (KHÔNG commit — đã có trong .gitignore). Mặc định false = dùng Postgres/Redis/Mongo cài trong cluster. Đọc k8s/infra/README.md mục 'Cloud config' trước khi bật.",
  "use_cloud_postgres": false,
  "use_cloud_redis": false,
  "//use_cloud_mongo": "Bỏ qua deploy MongoDB in-cluster. Không cần field host riêng ở đây — mỗi *_MONGODB_URI trong dev-secrets.env đã là connection string Atlas đầy đủ (mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/<db>).",
  "use_cloud_mongo": false,

  "//cloud_postgres_url": "jdbc:postgresql://<cloud-pg-host>:5432/auth_service?sslmode=require — chỉ dùng khi use_cloud_postgres=true. Username/password vẫn lấy từ k8s/infra/dev-secrets.env (AUTH_SERVICE__DATASOURCE_USERNAME/PASSWORD), đổi sang credential cloud thật ở đó.",
  "cloud_postgres_url": "",

  "//cloud_redis_host": "Chỉ dùng khi use_cloud_redis=true. Chỉ HOSTNAME thuần (vd optimum-osprey-150911.upstash.io) — KHÔNG dán nguyên URI redis://user:pass@host:port, password phải nằm ở dev-secrets.env. Áp dụng cho auth-service/user-service/movie-service/notification-service (REDIS_HOST đang nằm ở ConfigMap). api-gateway và streaming-service đọc REDIS_HOST từ Secret — sửa trực tiếp API_GATEWAY__REDIS_HOST/STREAMING_SERVICE__REDIS_HOST trong dev-secrets.env, không cần sửa ở đây.",
  "cloud_redis_host": "",
  "cloud_redis_port": "6379",

  "//cloud_redis_ssl_enabled": "Hầu hết Redis cloud (Upstash, Redis Cloud, ElastiCache có TLS...) bắt buộc TLS -> để true. Chỉ áp dụng cho 4 service đọc REDIS_HOST từ ConfigMap (auth/user/movie/notification) — api-gateway/streaming-service tự đặt REDIS_SSL_ENABLED trong dev-secrets.env.",
  "cloud_redis_ssl_enabled": true,

  "//use_monitoring": "Bật/tắt cả cụm Prometheus+Grafana+Alertmanager (kube-prometheus-stack) + Loki + Tempo + Alloy trong Tiltfile. Mặc định true theo yêu cầu gộp monitoring vào — khá nặng cho node nhỏ (docker-desktop), tắt bằng false nếu máy yếu hoặc tilt up quá lâu.",
  "use_monitoring": true
}
