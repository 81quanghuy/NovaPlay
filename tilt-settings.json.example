{
  "//": "Copy thành tilt-settings.json (KHÔNG commit — đã có trong .gitignore). Mặc định false = dùng Postgres/Redis cài trong cluster qua Bitnami chart (k8s/infra/*-values.yaml). Đọc k8s/infra/README.md mục 'Cloud config' trước khi bật.",
  "use_cloud_postgres": false,
  "use_cloud_redis": false,

  "//use_cloud_kafka": "Bỏ cài Kafka Bitnami in-cluster, trỏ toàn bộ sang Kafka managed (Aiven). Username/password nằm ở dev-secrets.env (<SERVICE>__KAFKA_SASL_USERNAME/PASSWORD), CA của project lưu ở k8s/infra/aiven-kafka-ca.pem. ĐỌC mục 'Kafka managed (Aiven)' trong k8s/infra/README.md trước khi bật: free tier chỉ cho 5 topic x 2 partition và KHÔNG auto-create, phải tạo topic tay.",
  "use_cloud_kafka": false,
  "cloud_kafka_bootstrap": "",

  "//use_cloud_storage": "Bỏ deploy MinIO in-cluster, cả media/streaming/transcoding-worker đọc ghi thẳng Cloudflare R2. Credential R2_* nằm ở dev-secrets.env cho từng service. Tiltfile tự đặt DEFAULT_STORAGE_PROVIDER=cloudflare-r2 và AWS_SQS_ENABLED=false cho media-service.",
  "use_cloud_storage": false,

  "//use_grafana_cloud": "Chỉ có tác dụng khi use_monitoring=true. Bật = KHÔNG cài Prometheus/Grafana/Loki/Tempo trong cụm, chỉ còn Alloy đẩy metrics/logs/traces lên Grafana Cloud (credential: các key GRAFANA_CLOUD__* trong dev-secrets.env). Đây là cách giảm RAM nhiều nhất trên máy local.",
  "use_grafana_cloud": false,

  "//use_cloudflare_tunnel": "Bật = deploy pod cloudflared để expose api-gateway ra internet cho Vercel FE. Token lấy từ Cloudflare Zero Trust và điền vào CLOUDFLARE_TUNNEL__TOKEN trong dev-secrets.env.",
  "use_cloudflare_tunnel": false,

  "//dev_scale_down": "Mặc định true. Ép mọi Deployment về 1 replica và hạ resources.requests xuống trần 250m CPU / 512Mi khi apply qua Tilt (KHÔNG sửa file yaml đã commit, KHÔNG đụng tới limits). Manifest gốc mô tả cụm nhiều node: 5.7 vCPU + 11.5 GiB requests, quá chỗ của một VM Docker Desktop -> pod đứng Pending. Đặt false nếu bạn chạy trên cụm thật.",
  "dev_scale_down": true,

