# Copy thành "prod-secrets.env" (ĐÃ gitignore — không bao giờ commit) rồi điền credential thật,
# sau đó chạy:
#
#   k8s/infra/scripts/seal-secrets.sh k8s/infra/prod-secrets.env
#
# Script mã hoá chúng thành k8s/<svc>/sealedsecret.yaml — những file ĐÓ mới an toàn để commit.
#
# Format giống dev-secrets.env: <TEN_SERVICE_VIET_HOA>__<TEN_KEY>
#
# ---------------------------------------------------------------------------
# VÌ SAO Ở ĐÂY CÓ CẢ NHỮNG KEY KHÔNG PHẢI SECRET (DATASOURCE_URL, REDIS_HOST, KAFKA_...)
# ---------------------------------------------------------------------------
# configmap.yaml đã commit đang trỏ vào hạ tầng IN-CLUSTER của dev ("postgres:5432",
# "redis-master", "kafka:9092"). Prod dùng managed service nên các giá trị đó sai hết.
#
# Deployment khai envFrom theo thứ tự [configMapRef, secretRef], và env đứng SAU thắng — nên đặt
# lại chúng ở đây là ghi đè được configmap mà KHÔNG phải sửa file đã commit hay viết kustomize
# patch riêng. Đổi lại, endpoint của bạn nằm trong secret đã mã hoá thay vì lộ trong Git.
# ---------------------------------------------------------------------------

# ===========================================================================
# auth-service — Postgres managed (Supabase / Neon)
# ===========================================================================
# QUAN TRỌNG: dùng endpoint DIRECT, không phải pooled.
#   Supabase -> cổng 5432 (KHÔNG phải 6543)
#   Neon     -> host KHÔNG có hậu tố "-pooler"
# Outbox dựa vào LISTEN/NOTIFY, thứ không chạy qua PgBouncer transaction mode. Nếu buộc phải đi
# qua pooler, thêm AUTH_SERVICE__OUTBOX_LISTEN_ENABLED=false và OUTBOX_POLL_INTERVAL=5s bên dưới.
AUTH_SERVICE__DATASOURCE_URL=jdbc:postgresql://<host>:5432/auth_service?sslmode=require
AUTH_SERVICE__DATASOURCE_USERNAME=
AUTH_SERVICE__DATASOURCE_PASSWORD=
# Trần connection MỖI POD. maxReplicas của auth-service là 3, mỗi pod còn thêm 1 connection LISTEN
# => 3 x (5+1) = 18. Nới số này phải kiểm tra lại hạn mức của nhà cung cấp.
AUTH_SERVICE__DATASOURCE_MAX_POOL_SIZE=5
# Chỉ đặt hai dòng dưới nếu connection string trỏ vào endpoint pooled:
# AUTH_SERVICE__OUTBOX_LISTEN_ENABLED=false
# AUTH_SERVICE__OUTBOX_POLL_INTERVAL=5s
AUTH_SERVICE__REDIS_HOST=
AUTH_SERVICE__REDIS_PORT=6379
AUTH_SERVICE__REDIS_PASSWORD=
AUTH_SERVICE__REDIS_SSL_ENABLED=true
AUTH_SERVICE__KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ===========================================================================
# GATEWAY_SHARED_SECRET — phải GIỐNG HỆT nhau ở 7 service dưới đây
# ===========================================================================
# Lệch một ký tự là MỌI request downstream trả 403, kể cả duyệt catalog công khai: gateway gắn
# header này cho cả traffic ẩn danh vì nó chứng minh "đã đi qua gateway", không phải "đã đăng
# nhập". Sinh một lần rồi dán lại y hệt:  openssl rand -base64 32
API_GATEWAY__GATEWAY_SHARED_SECRET=
MOVIE_SERVICE__GATEWAY_SHARED_SECRET=
USER_SERVICE__GATEWAY_SHARED_SECRET=
MEDIA_SERVICE__GATEWAY_SHARED_SECRET=
NOTIFICATION_SERVICE__GATEWAY_SHARED_SECRET=
STREAMING_SERVICE__GATEWAY_SHARED_SECRET=
TRANSCODING_WORKER__GATEWAY_SHARED_SECRET=

# ===========================================================================
# Redis Cloud — dùng chung, mỗi service một mật khẩu giống nhau
# ===========================================================================
API_GATEWAY__REDIS_HOST=
API_GATEWAY__REDIS_PORT=6379
API_GATEWAY__REDIS_PASSWORD=
API_GATEWAY__REDIS_SSL_ENABLED=true
MOVIE_SERVICE__REDIS_HOST=
MOVIE_SERVICE__REDIS_PASSWORD=
MOVIE_SERVICE__REDIS_SSL_ENABLED=true
USER_SERVICE__REDIS_HOST=
USER_SERVICE__REDIS_PASSWORD=
USER_SERVICE__REDIS_SSL_ENABLED=true
NOTIFICATION_SERVICE__REDIS_HOST=
NOTIFICATION_SERVICE__REDIS_PASSWORD=
NOTIFICATION_SERVICE__REDIS_SSL_ENABLED=true
STREAMING_SERVICE__REDIS_HOST=
STREAMING_SERVICE__REDIS_PASSWORD=
STREAMING_SERVICE__REDIS_SSL_ENABLED=true

# ===========================================================================
# MongoDB Atlas — MỘT cluster, mỗi service MỘT database (giống hệt cách Mongo in-cluster đang chạy)
# ===========================================================================
# Không cần "?replicaSet=rs0" — cluster Atlas đã tự là replica set.
USER_SERVICE__MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/user_service?retryWrites=true&w=majority
MOVIE_SERVICE__MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/movie_service?retryWrites=true&w=majority
MEDIA_SERVICE__MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/media_service?retryWrites=true&w=majority
NOTIFICATION_SERVICE__MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/notification_service?retryWrites=true&w=majority
STREAMING_SERVICE__MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/streaming_service?retryWrites=true&w=majority
CONFIG_SERVICE__MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/config_service?retryWrites=true&w=majority

# ===========================================================================
# Kafka in-cluster
# ===========================================================================
MEDIA_SERVICE__KAFKA_BOOTSTRAP_SERVERS=kafka:9092
NOTIFICATION_SERVICE__KAFKA_BOOTSTRAP_SERVERS=kafka:9092
USER_SERVICE__KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TRANSCODING_WORKER__KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ===========================================================================
# TRANSCODE_KEY_WRAP_SECRET — phải GIỐNG HỆT ở transcoding-worker và streaming-service
# ===========================================================================
# Worker dùng nó để wrap khoá AES-128 của segment HLS, streaming-service dùng để unwrap. Lệch giá
# trị thì video đã transcode xong vẫn không phát được, và lỗi xuất hiện ở tận trình phát chứ
# không phải lúc deploy.  Sinh:  openssl rand -base64 32
TRANSCODING_WORKER__TRANSCODE_KEY_WRAP_SECRET=
STREAMING_SERVICE__TRANSCODE_KEY_WRAP_SECRET=

# Token chứng minh "user này được phép xem manifest này". Chỉ streaming-service dùng, không cần
# chia sẻ với ai.  Sinh:  openssl rand -base64 32
STREAMING_SERVICE__PLAYBACK_TOKEN_SECRET=

# URI nội bộ — Service DNS trong cùng namespace, không cần đổi trừ khi đổi tên service.
STREAMING_SERVICE__MEDIA_SERVICE_URI=http://media-service:8081
STREAMING_SERVICE__MOVIE_SERVICE_URI=http://movie-service:8600
TRANSCODING_WORKER__MEDIA_SERVICE_URI=http://media-service:8081

# ===========================================================================
# SMTP thật (notification-service)
# ===========================================================================
# configmap đang trỏ MAIL_HOST=smtp.gmail.com. Với Gmail phải dùng App Password, không phải mật
# khẩu tài khoản.
NOTIFICATION_SERVICE__MAIL_USERNAME=
NOTIFICATION_SERVICE__MAIL_PASSWORD=

# ===========================================================================
# Object storage (media/streaming/transcoding-worker) — CẢ BA phải trỏ CÙNG MỘT bucket
# ===========================================================================
# Khác bucket thì upload chạy, transcode chạy, nhưng playback trả 404 vì segment nằm ở nơi khác.
MEDIA_SERVICE__AWS_S3_BUCKET_NAME=
MEDIA_SERVICE__AWS_REGION=
MEDIA_SERVICE__AWS_ACCESS_KEY_ID=
MEDIA_SERVICE__AWS_SECRET_ACCESS_KEY=
MEDIA_SERVICE__AWS_SQS_QUEUE_NAME=
STREAMING_SERVICE__AWS_S3_BUCKET_NAME=
STREAMING_SERVICE__AWS_REGION=
STREAMING_SERVICE__AWS_ACCESS_KEY_ID=
STREAMING_SERVICE__AWS_SECRET_ACCESS_KEY=
TRANSCODING_WORKER__AWS_S3_BUCKET_NAME=
TRANSCODING_WORKER__AWS_REGION=
TRANSCODING_WORKER__AWS_ACCESS_KEY_ID=
TRANSCODING_WORKER__AWS_SECRET_ACCESS_KEY=
