# Copy file này thành "dev-secrets.env" (KHÔNG commit — đã có trong .gitignore) rồi điền giá trị.
#
# Format: <TEN_SERVICE_VIET_HOA>__<TEN_KEY> — dấu gạch dưới đôi "__" phân tách service và key.
# k8s/infra/scripts/apply-dev-secrets.sh đọc file này và tạo/update từng k8s Secret tương ứng
# (vd AUTH_SERVICE__DATASOURCE_USERNAME -> key "DATASOURCE_USERNAME" trong Secret "auth-service-secrets").
# Danh sách key của mỗi service là bản sao chính xác của k8s/<service>/secret.example.yaml.
#
# Toàn bộ giá trị mặc định dưới đây KHỚP với docker-compose/qa/docker-compose.yml và
# k8s/infra/*-values.yaml đang dùng cho dev — dev nào đã chạy docker-compose thì dùng file này
# nguyên trạng, không cần sửa gì để `tilt up` chạy được.
#
# Muốn trỏ Postgres/Redis sang cloud managed instance: xem tilt-settings.json.example
# (use_cloud_postgres/use_cloud_redis) rồi đổi giá trị USERNAME/PASSWORD tương ứng bên dưới sang
# credential cloud thật — KHÔNG sửa DATASOURCE_URL/REDIS_HOST ở đây, hai giá trị đó nằm trong
# tilt-settings.json vì chúng không phải secret.

# --- auth-service (Postgres qua Bitnami chart: k8s/infra/postgresql-values.yaml) ---
AUTH_SERVICE__DATASOURCE_USERNAME=admin
AUTH_SERVICE__DATASOURCE_PASSWORD=admin123
AUTH_SERVICE__REDIS_PASSWORD=redis123

# --- api-gateway (Redis qua Bitnami chart: k8s/infra/redis-values.yaml, Service "redis-master") ---
API_GATEWAY__GATEWAY_SHARED_SECRET=novaplay-gateway-shared-secret
API_GATEWAY__REDIS_HOST=redis-master
API_GATEWAY__REDIS_PORT=6379
API_GATEWAY__REDIS_PASSWORD=redis123
API_GATEWAY__REDIS_SSL_ENABLED=false

# --- config-service (Mongo tự viết tay: k8s/infra/mongodb/, không auth) ---
CONFIG_SERVICE__MONGODB_URI=mongodb://mongodb:27017/config_service?replicaSet=rs0

# --- user-service ---
USER_SERVICE__MONGODB_URI=mongodb://mongodb:27017/user_service?replicaSet=rs0
USER_SERVICE__REDIS_PASSWORD=redis123
USER_SERVICE__GATEWAY_SHARED_SECRET=novaplay-gateway-shared-secret

# --- movie-service ---
MOVIE_SERVICE__MONGODB_URI=mongodb://mongodb:27017/movie_service?replicaSet=rs0
MOVIE_SERVICE__REDIS_PASSWORD=redis123
MOVIE_SERVICE__GATEWAY_SHARED_SECRET=novaplay-gateway-shared-secret

# --- notification-service (MAIL_USERNAME/PASSWORD không thật sự dùng khi chạy qua Tilt: Tiltfile
#     ghi đè MAIL_HOST/MAIL_PORT trỏ về Mailhog trong cụm, vốn không yêu cầu xác thực) ---
NOTIFICATION_SERVICE__MONGODB_URI=mongodb://mongodb:27017/notification_service?replicaSet=rs0
NOTIFICATION_SERVICE__REDIS_PASSWORD=redis123
NOTIFICATION_SERVICE__MAIL_USERNAME=dev@novaplay.local
NOTIFICATION_SERVICE__MAIL_PASSWORD=unused-mailhog-no-auth
NOTIFICATION_SERVICE__GATEWAY_SHARED_SECRET=novaplay-gateway-shared-secret

# --- media-service (KAFKA_BOOTSTRAP_SERVERS nằm ở Secret, không phải configmap, theo đúng
#     k8s/media-service/secret.example.yaml đã có sẵn) ---
MEDIA_SERVICE__MONGODB_URI=mongodb://mongodb:27017/media_service?replicaSet=rs0
MEDIA_SERVICE__KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MEDIA_SERVICE__AWS_SQS_QUEUE_NAME=media-upload-events-dev
MEDIA_SERVICE__GATEWAY_SHARED_SECRET=novaplay-gateway-shared-secret

# --- streaming-service (PLAYBACK_TOKEN_SECRET/TRANSCODE_KEY_WRAP_SECRET: cùng giá trị mặc định
#     base64 đã hardcode sẵn trong docker-compose/qa/docker-compose.yml, chỉ dùng cho dev) ---
STREAMING_SERVICE__MONGODB_URI=mongodb://mongodb:27017/streaming_service?replicaSet=rs0
STREAMING_SERVICE__REDIS_HOST=redis-master
STREAMING_SERVICE__REDIS_PASSWORD=redis123
STREAMING_SERVICE__MOVIE_SERVICE_URI=http://movie-service:8600
STREAMING_SERVICE__MEDIA_SERVICE_URI=http://media-service:8081
STREAMING_SERVICE__GATEWAY_SHARED_SECRET=novaplay-gateway-shared-secret
STREAMING_SERVICE__PLAYBACK_TOKEN_SECRET=MTIzNDU2Nzg5MGFiY2RlZjEyMzQ1Njc4OTBhYmNkZWY=
STREAMING_SERVICE__TRANSCODE_KEY_WRAP_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- transcoding-worker (TRANSCODE_KEY_WRAP_SECRET PHẢI khớp streaming-service ở trên) ---
TRANSCODING_WORKER__KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TRANSCODING_WORKER__MEDIA_SERVICE_URI=http://media-service:8081
TRANSCODING_WORKER__GATEWAY_SHARED_SECRET=novaplay-gateway-shared-secret
TRANSCODING_WORKER__TRANSCODE_KEY_WRAP_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ===========================================================================================
# Kafka managed — Aiven (tilt-settings.json: use_cloud_kafka=true)
# ===========================================================================================
# Username/password lấy ở Aiven Console -> service Kafka -> Connect information -> tab
# "Apache Kafka", Authentication method = SASL (KHÔNG phải Client certificate; hai cách dùng hai
# CỔNG khác nhau, dán nhầm port là connection timeout chứ không phải lỗi auth).
#
# Cùng một cặp user/password cho cả 5 service — Aiven free tier chỉ có sẵn user "avnadmin".
# CÒN THIẾU MỘT THỨ NỮA ngoài file này: CA certificate của project, tải ở đúng màn hình trên
# (dòng "CA certificate" -> Download) và lưu thành k8s/infra/aiven-kafka-ca.pem.
AUTH_SERVICE__KAFKA_SASL_USERNAME=avnadmin
AUTH_SERVICE__KAFKA_SASL_PASSWORD=
NOTIFICATION_SERVICE__KAFKA_SASL_USERNAME=avnadmin
NOTIFICATION_SERVICE__KAFKA_SASL_PASSWORD=
USER_SERVICE__KAFKA_SASL_USERNAME=avnadmin
USER_SERVICE__KAFKA_SASL_PASSWORD=
MEDIA_SERVICE__KAFKA_SASL_USERNAME=avnadmin
MEDIA_SERVICE__KAFKA_SASL_PASSWORD=
TRANSCODING_WORKER__KAFKA_SASL_USERNAME=avnadmin
TRANSCODING_WORKER__KAFKA_SASL_PASSWORD=

# ===========================================================================================
# Object storage — Cloudflare R2 (tilt-settings.json: use_cloud_storage=true)
# ===========================================================================================
# CẢ BA service media/streaming/transcoding-worker phải trỏ CÙNG một bucket: media ký URL
# upload, worker ghi HLS output, streaming đọc segment ra. Lệch bucket = playback 404 dù
# transcode báo thành công, và không có log lỗi nào ở giữa.
#
# R2_ACCOUNT_ID: chuỗi hex trong URL dashboard Cloudflare (endpoint sẽ là
# https://<account-id>.r2.cloudflarestorage.com). R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY: tạo ở
# R2 -> Manage API tokens -> Create API token, quyền Object Read & Write cho đúng bucket.
MEDIA_SERVICE__R2_ACCOUNT_ID=
MEDIA_SERVICE__R2_BUCKET_NAME=
MEDIA_SERVICE__R2_ACCESS_KEY_ID=
MEDIA_SERVICE__R2_SECRET_ACCESS_KEY=
STREAMING_SERVICE__R2_ACCOUNT_ID=
STREAMING_SERVICE__R2_BUCKET_NAME=
STREAMING_SERVICE__R2_ACCESS_KEY_ID=
STREAMING_SERVICE__R2_SECRET_ACCESS_KEY=
TRANSCODING_WORKER__R2_ACCOUNT_ID=
TRANSCODING_WORKER__R2_BUCKET_NAME=
TRANSCODING_WORKER__R2_ACCESS_KEY_ID=
TRANSCODING_WORKER__R2_SECRET_ACCESS_KEY=

# R2_CDN_BASE_URL (chỉ media-service đọc): để TRỐNG là dùng presigned URL. Chỉ điền khi đã gắn
# custom domain/r2.dev public cho bucket — điền sai thì URL trả về client 404 mà media-service
# không hề biết.
MEDIA_SERVICE__R2_CDN_BASE_URL=

# ===========================================================================================
# Grafana Cloud (tilt-settings.json: use_grafana_cloud=true)
# ===========================================================================================
# Tạo Secret "grafana-cloud-secrets" trong namespace monitoring, Alloy đọc bằng sys.env().
# Lấy giá trị ở grafana.com -> stack của bạn -> từng mục Details:
#   - Prometheus: "Remote Write Endpoint" (…/api/prom/push) + "Username / Instance ID" (số)
#   - Loki:       "URL" (…/loki/api/v1/push)               + "User" (số)
#   - Tempo:      dùng OTLP endpoint (…/otlp)              + "User / Instance ID" (số)
# TOKEN: một Access Policy Token DUY NHẤT dùng chung cho cả ba, scope cần metrics:write,
# logs:write, traces:write. Đây là token "glc_...", KHÔNG phải API key của tài khoản.
GRAFANA_CLOUD__GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD__GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD__GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD__GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD__GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD__GRAFANA_CLOUD_OTLP_USER=
GRAFANA_CLOUD__GRAFANA_CLOUD_TOKEN=
